# ---- 値は Dokku の環境変数に設定する（dokku config:set iec-ec-bridge KEY=VALUE）。このファイルは項目の一覧 ----
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=bridge.iida-eye.jp
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Shopify
SHOPIFY_SHOP_DOMAIN=iida-eye-shop-dev.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2025-07
SHOPIFY_RX_REQUIRED_TAG=rx-required

# FileMaker Data API
FM_HOST=fms.example.jp
FM_DATABASE=Helm_cData
FM_USER=ec_bridge
FM_PASSWORD=
FM_VERIFY_TLS=1
FM_DATE_FORMAT=%m/%d/%Y
FM_LAYOUT_PRODUCT=api_CL_Product
FM_LAYOUT_RX=api_CL_Rx
FM_LAYOUT_RXLINE=api_CL_RxLine
FM_LAYOUT_DISPENSE=api_CL_Dispense
# LINE ID 対応テーブル（テーブル名・フィールド名は未確認。判明したら設定する）
FM_LAYOUT_LINELINK=api_LineLink
FM_LINELINK_LINE_FIELD=line_user_id
FM_LINELINK_PATIENT_FIELD=patient_id

# 既存 LIFF / FileMaker スクリプトからの /api/* 呼び出し
API_SHARED_KEY=
API_ALLOWED_IPS=

# 業務設定
SHIPPING_ENABLED=0
SPARE_BOXES=1
PENDING_ALERT_MINUTES=30
CLINIC_NAME=医療法人 イイダ眼科医院
CLINIC_ADDRESS=
CLINIC_TEL=
CLINIC_FAX=
PO_OUTPUT_DIR=/app/var/po
PO_METHOD=fax_pdf
PO_EMAIL_FROM=
# 発注先メール（email 方式のとき）。"発注先名=メール;発注先名=メール"
PO_SUPPLIER_EMAILS=
STAFF_NOTIFY_EMAIL=
